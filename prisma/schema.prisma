generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum platform_role {
  USER
  PLATFORM_ADMIN
}

enum tenant_role {
  COMPANY_ADMIN
  DATA_ENTRY
  VIEWER
}

enum assessment_status {
  DRAFT
  ACTIVE
  FINALIZED
  ARCHIVED
}

enum activity_status {
  DRAFT
  VALIDATED
  CALCULATED
}

enum data_source_type {
  MANUAL
  INVOICE
  METER
  ERP
  OTHER
}

enum evidence_type {
  INVOICE
  METER_RECORD
  ERP_EXPORT
  OTHER
}

enum calculation_status {
  PENDING
  SUCCESS
  FAILED
}

enum report_status {
  GENERATING
  READY
  FAILED
}

enum scope_type {
  SCOPE_1
  SCOPE_2
  SCOPE_3
}

enum emission_category {
  STATIONARY_COMBUSTION
}

enum gas_type {
  CO2
  CH4
  N2O
}

enum audit_action {
  CREATE
  UPDATE
  DELETE
  CALCULATE
  FINALIZE
  EXPORT
}

model users {
  id                          String                 @id @default(uuid()) @db.Uuid
  email                       String                 @unique @db.VarChar(255)
  password_hash               String                 @db.VarChar(255)
  full_name                   String                 @db.VarChar(150)
  platform_role               platform_role          @default(USER)
  is_active                   Boolean                @default(true)
  last_login_at               DateTime?              @db.Timestamptz
  created_at                  DateTime               @default(now()) @db.Timestamptz
  updated_at                  DateTime               @updatedAt @db.Timestamptz
  tenant_memberships          tenant_memberships[]
  created_assessments         carbon_assessments[]   @relation("assessment_created_by")
  finalized_assessments       carbon_assessments[]   @relation("assessment_finalized_by")
  entered_activities          natural_gas_activities[] @relation("activity_entered_by")
  validated_activities        natural_gas_activities[] @relation("activity_validated_by")
  uploaded_evidence           activity_evidence[]
  initiated_calculations      calculation_runs[]
  generated_reports           reports[]
  audit_logs                  audit_logs[]
}

model tenants {
  id                     String                   @id @default(uuid()) @db.Uuid
  name                   String                   @db.VarChar(200)
  legal_name             String?                  @db.VarChar(255)
  slug                   String                   @unique @db.VarChar(120)
  tax_number             String?                  @db.VarChar(50)
  country_code           String?                  @db.VarChar(2)
  is_active              Boolean                  @default(true)
  created_at             DateTime                 @default(now()) @db.Timestamptz
  updated_at             DateTime                 @updatedAt @db.Timestamptz
  memberships            tenant_memberships[]
  facilities             facilities[]
  assessments            carbon_assessments[]
  activities             natural_gas_activities[]
  evidence               activity_evidence[]
  calculation_runs       calculation_runs[]
  reports                reports[]
  audit_logs             audit_logs[]
}

model tenant_memberships {
  id         String      @id @default(uuid()) @db.Uuid
  tenant_id  String      @db.Uuid
  user_id    String      @db.Uuid
  role       tenant_role
  is_active  Boolean     @default(true)
  created_at DateTime    @default(now()) @db.Timestamptz
  updated_at DateTime    @updatedAt @db.Timestamptz
  tenant     tenants     @relation(fields: [tenant_id], references: [id])
  user       users       @relation(fields: [user_id], references: [id])

  @@unique([tenant_id, user_id])
  @@index([user_id])
}

model facilities {
  id                    String                  @id @default(uuid()) @db.Uuid
  tenant_id             String                  @db.Uuid
  name                  String                  @db.VarChar(200)
  code                  String?                 @db.VarChar(50)
  country_code          String?                 @db.VarChar(2)
  city                  String?                 @db.VarChar(120)
  district              String?                 @db.VarChar(120)
  address               String?
  is_active             Boolean                 @default(true)
  created_at            DateTime                @default(now()) @db.Timestamptz
  updated_at            DateTime                @updatedAt @db.Timestamptz
  tenant                tenants                 @relation(fields: [tenant_id], references: [id])
  assessment_facilities assessment_facilities[]
  activities            natural_gas_activities[]

  @@unique([tenant_id, code])
}

model carbon_assessments {
  id                       String                  @id @default(uuid()) @db.Uuid
  tenant_id                String                  @db.Uuid
  name                     String                  @db.VarChar(200)
  period_start             DateTime                @db.Date
  period_end               DateTime                @db.Date
  status                   assessment_status       @default(DRAFT)
  created_by_user_id       String                  @db.Uuid
  finalized_by_user_id     String?                 @db.Uuid
  finalized_at             DateTime?               @db.Timestamptz
  created_at               DateTime                @default(now()) @db.Timestamptz
  updated_at               DateTime                @updatedAt @db.Timestamptz
  tenant                   tenants                 @relation(fields: [tenant_id], references: [id])
  created_by               users                   @relation("assessment_created_by", fields: [created_by_user_id], references: [id])
  finalized_by             users?                  @relation("assessment_finalized_by", fields: [finalized_by_user_id], references: [id])
  assessment_facilities    assessment_facilities[]
  activities               natural_gas_activities[]
  calculation_runs         calculation_runs[]
  reports                  reports[]

  @@index([tenant_id])
  @@index([tenant_id, period_start, period_end])
}

model assessment_facilities {
  assessment_id String             @db.Uuid
  facility_id   String             @db.Uuid
  created_at    DateTime           @default(now()) @db.Timestamptz
  assessment    carbon_assessments @relation(fields: [assessment_id], references: [id])
  facility      facilities         @relation(fields: [facility_id], references: [id])

  @@id([assessment_id, facility_id])
  @@index([facility_id])
}

model units {
  id                 String                   @id @default(uuid()) @db.Uuid
  code               String                   @unique @db.VarChar(30)
  name               String                   @db.VarChar(100)
  symbol             String                   @db.VarChar(30)
  dimension          String                   @db.VarChar(50)
  is_active          Boolean                  @default(true)
  activities         natural_gas_activities[]
  emission_factors   emission_factors[]
}

model natural_gas_activities {
  id                   String             @id @default(uuid()) @db.Uuid
  tenant_id            String             @db.Uuid
  assessment_id        String             @db.Uuid
  facility_id          String             @db.Uuid
  period_start         DateTime           @db.Date
  period_end           DateTime           @db.Date
  consumption_value    Decimal            @db.Decimal(20, 6)
  unit_id              String             @db.Uuid
  source_type          data_source_type
  source_reference     String?            @db.VarChar(255)
  invoice_number       String?            @db.VarChar(100)
  supplier_name        String?            @db.VarChar(200)
  meter_number         String?            @db.VarChar(100)
  notes                String?
  status               activity_status    @default(DRAFT)
  entered_by_user_id   String             @db.Uuid
  validated_by_user_id String?            @db.Uuid
  validated_at         DateTime?          @db.Timestamptz
  created_at           DateTime           @default(now()) @db.Timestamptz
  updated_at           DateTime           @updatedAt @db.Timestamptz
  tenant               tenants            @relation(fields: [tenant_id], references: [id])
  assessment           carbon_assessments @relation(fields: [assessment_id], references: [id])
  facility             facilities         @relation(fields: [facility_id], references: [id])
  unit                 units              @relation(fields: [unit_id], references: [id])
  entered_by           users              @relation("activity_entered_by", fields: [entered_by_user_id], references: [id])
  validated_by         users?             @relation("activity_validated_by", fields: [validated_by_user_id], references: [id])
  evidence             activity_evidence[]
  calculation_runs     calculation_runs[]

  @@index([tenant_id])
  @@index([assessment_id])
  @@index([facility_id])
  @@index([tenant_id, facility_id, period_start, period_end])
}

model activity_evidence {
  id                      String                 @id @default(uuid()) @db.Uuid
  tenant_id               String                 @db.Uuid
  natural_gas_activity_id String                 @db.Uuid
  evidence_type           evidence_type
  original_file_name      String                 @db.VarChar(255)
  storage_key             String                 @db.VarChar(500)
  mime_type               String?                @db.VarChar(100)
  file_size_bytes         BigInt?
  checksum_sha256         String?                @db.VarChar(64)
  uploaded_by_user_id     String                 @db.Uuid
  created_at              DateTime               @default(now()) @db.Timestamptz
  tenant                  tenants                @relation(fields: [tenant_id], references: [id])
  activity                natural_gas_activities @relation(fields: [natural_gas_activity_id], references: [id])
  uploaded_by             users                  @relation(fields: [uploaded_by_user_id], references: [id])

  @@index([tenant_id])
  @@index([natural_gas_activity_id])
}

model emission_factor_sources {
  id                 String             @id @default(uuid()) @db.Uuid
  name               String             @db.VarChar(200)
  publisher          String             @db.VarChar(200)
  publication_year   Int
  version            String?            @db.VarChar(100)
  source_url         String?            @db.VarChar(1000)
  document_reference String?            @db.VarChar(500)
  valid_from         DateTime?          @db.Date
  valid_to           DateTime?          @db.Date
  created_at         DateTime           @default(now()) @db.Timestamptz
  updated_at         DateTime           @updatedAt @db.Timestamptz
  factors            emission_factors[]
}

model emission_factors {
  id                  String                       @id @default(uuid()) @db.Uuid
  source_id           String                       @db.Uuid
  activity_name       String                       @db.VarChar(150)
  scope               scope_type
  category            emission_category
  country_code        String?                      @db.VarChar(2)
  input_unit_id       String                       @db.Uuid
  valid_from          DateTime?                    @db.Date
  valid_to            DateTime?                    @db.Date
  is_active           Boolean                      @default(true)
  created_at          DateTime                     @default(now()) @db.Timestamptz
  updated_at          DateTime                     @updatedAt @db.Timestamptz
  source              emission_factor_sources      @relation(fields: [source_id], references: [id])
  input_unit          units                        @relation(fields: [input_unit_id], references: [id])
  components          emission_factor_components[]
  calculation_runs    calculation_runs[]

  @@index([source_id])
  @@index([activity_name, scope, category])
}

model emission_factor_components {
  id                 String           @id @default(uuid()) @db.Uuid
  emission_factor_id String           @db.Uuid
  gas                gas_type
  factor_value       Decimal          @db.Decimal(24, 12)
  factor_unit        String           @db.VarChar(120)
  created_at         DateTime         @default(now()) @db.Timestamptz
  emission_factor    emission_factors @relation(fields: [emission_factor_id], references: [id])

  @@unique([emission_factor_id, gas])
}

model gwp_sets {
  id               String       @id @default(uuid()) @db.Uuid
  name             String       @db.VarChar(100)
  publisher        String       @db.VarChar(150)
  version          String       @db.VarChar(50)
  publication_year Int?
  source_reference String?      @db.VarChar(500)
  is_active        Boolean      @default(true)
  created_at       DateTime     @default(now()) @db.Timestamptz
  values           gwp_values[]
  calculation_runs calculation_runs[]

  @@unique([name, version])
}

model gwp_values {
  id         String    @id @default(uuid()) @db.Uuid
  gwp_set_id String    @db.Uuid
  gas        gas_type
  gwp_value  Decimal   @db.Decimal(18, 8)
  created_at DateTime  @default(now()) @db.Timestamptz
  gwp_set    gwp_sets  @relation(fields: [gwp_set_id], references: [id])

  @@unique([gwp_set_id, gas])
}

model calculation_runs {
  id                         String                         @id @default(uuid()) @db.Uuid
  tenant_id                  String                         @db.Uuid
  assessment_id              String                         @db.Uuid
  natural_gas_activity_id    String                         @db.Uuid
  emission_factor_id         String                         @db.Uuid
  gwp_set_id                 String                         @db.Uuid
  calculation_engine_version String                         @db.VarChar(50)
  status                     calculation_status
  error_message              String?
  initiated_by_user_id       String?                        @db.Uuid
  calculated_at              DateTime?                      @db.Timestamptz
  created_at                 DateTime                       @default(now()) @db.Timestamptz
  tenant                     tenants                        @relation(fields: [tenant_id], references: [id])
  assessment                 carbon_assessments             @relation(fields: [assessment_id], references: [id])
  activity                   natural_gas_activities         @relation(fields: [natural_gas_activity_id], references: [id])
  emission_factor            emission_factors               @relation(fields: [emission_factor_id], references: [id])
  gwp_set                    gwp_sets                       @relation(fields: [gwp_set_id], references: [id])
  initiated_by               users?                         @relation(fields: [initiated_by_user_id], references: [id])
  input_snapshot             calculation_input_snapshots?
  factor_snapshot            calculation_factor_snapshots?
  result                     calculation_results?

  @@index([tenant_id])
  @@index([assessment_id])
  @@index([natural_gas_activity_id])
}

model calculation_input_snapshots {
  id                           String           @id @default(uuid()) @db.Uuid
  calculation_run_id           String           @unique @db.Uuid
  consumption_value            Decimal          @db.Decimal(20, 6)
  consumption_unit             String           @db.VarChar(30)
  normalized_consumption_value Decimal          @db.Decimal(20, 6)
  normalized_unit              String           @db.VarChar(30)
  activity_period_start        DateTime         @db.Date
  activity_period_end          DateTime         @db.Date
  facility_name                String           @db.VarChar(200)
  created_at                   DateTime         @default(now()) @db.Timestamptz
  calculation_run              calculation_runs @relation(fields: [calculation_run_id], references: [id])
}

model calculation_factor_snapshots {
  id                    String           @id @default(uuid()) @db.Uuid
  calculation_run_id    String           @unique @db.Uuid
  factor_source_name    String           @db.VarChar(200)
  factor_source_version String?          @db.VarChar(100)
  publication_year      Int?
  input_unit            String           @db.VarChar(30)
  co2_factor            Decimal          @db.Decimal(24, 12)
  ch4_factor            Decimal?         @db.Decimal(24, 12)
  n2o_factor            Decimal?         @db.Decimal(24, 12)
  co2_gwp               Decimal          @db.Decimal(18, 8)
  ch4_gwp               Decimal?         @db.Decimal(18, 8)
  n2o_gwp               Decimal?         @db.Decimal(18, 8)
  created_at            DateTime         @default(now()) @db.Timestamptz
  calculation_run       calculation_runs @relation(fields: [calculation_run_id], references: [id])
}

model calculation_results {
  id                 String            @id @default(uuid()) @db.Uuid
  calculation_run_id String            @unique @db.Uuid
  co2_mass_kg        Decimal           @db.Decimal(24, 10)
  ch4_mass_kg        Decimal?          @db.Decimal(24, 10)
  n2o_mass_kg        Decimal?          @db.Decimal(24, 10)
  co2_co2e_kg        Decimal           @db.Decimal(24, 10)
  ch4_co2e_kg        Decimal?          @db.Decimal(24, 10)
  n2o_co2e_kg        Decimal?          @db.Decimal(24, 10)
  total_co2e_kg      Decimal           @db.Decimal(24, 10)
  scope              scope_type
  category           emission_category
  created_at         DateTime          @default(now()) @db.Timestamptz
  calculation_run    calculation_runs  @relation(fields: [calculation_run_id], references: [id])
}

model reports {
  id                   String             @id @default(uuid()) @db.Uuid
  tenant_id            String             @db.Uuid
  assessment_id        String             @db.Uuid
  status               report_status
  report_version       Int
  file_name            String?            @db.VarChar(255)
  storage_key          String?            @db.VarChar(500)
  generated_by_user_id String?            @db.Uuid
  generated_at         DateTime?          @db.Timestamptz
  created_at           DateTime           @default(now()) @db.Timestamptz
  tenant               tenants            @relation(fields: [tenant_id], references: [id])
  assessment           carbon_assessments @relation(fields: [assessment_id], references: [id])
  generated_by         users?             @relation(fields: [generated_by_user_id], references: [id])

  @@index([tenant_id])
  @@index([assessment_id])
  @@unique([assessment_id, report_version])
}

model audit_logs {
  id          String       @id @default(uuid()) @db.Uuid
  tenant_id   String?      @db.Uuid
  user_id     String?      @db.Uuid
  action      audit_action
  entity_type String       @db.VarChar(100)
  entity_id   String?      @db.Uuid
  old_values  Json?
  new_values  Json?
  ip_address  String?      @db.VarChar(45)
  user_agent  String?
  occurred_at DateTime     @default(now()) @db.Timestamptz
  tenant      tenants?     @relation(fields: [tenant_id], references: [id])
  user        users?       @relation(fields: [user_id], references: [id])

  @@index([tenant_id])
  @@index([user_id])
  @@index([entity_type, entity_id])
  @@index([occurred_at])
}
